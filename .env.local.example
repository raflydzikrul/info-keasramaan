# Salin file ini jadi .env.local, lalu isi dengan nilai dari
# Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Password untuk membuka bagian Kedisiplinan
# (Daftar Pelanggaran, Input Pelanggaran, Kategori Pelanggaran)
KEDISIPLINAN_PASSWORD=ganti-dengan-password-rahasia-kamu

# Password untuk membuka bagian Jurnal Piket Asrama
# Sengaja dipisah dari password kedisiplinan supaya petugas piket
# tidak otomatis bisa membuka data pelanggaran santri, dan sebaliknya.
JURNAL_PIKET_PASSWORD=ganti-dengan-password-piket-kamu

# PENTING: SUPABASE_SERVICE_ROLE_KEY adalah kunci rahasia dengan akses penuh
# ke database, melewati Row Level Security. JANGAN commit file .env.local ke
# Git, dan jangan pernah dipakai di kode yang berjalan di browser.
